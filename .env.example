# Copy this file to ".env" and fill in your real tokens.
# Never commit the real .env file (it is gitignored).

# Bot User OAuth Token - from Slack > OAuth & Permissions (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-token-here

# App-Level Token - from Slack > Basic Information > App-Level Tokens (starts with xapp-)
SLACK_APP_TOKEN=xapp-your-token-here

# The slash-command prefix you registered in Slack, without the leading slash.
# Example: if your command is "/sripin-ping", set this to "sripin".
COMMAND_PREFIX=sripin

# Port for the local health-check page (optional).
PORT=3000
