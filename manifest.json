{
  "display_information": {
    "name": "Sripin Bot",
    "description": "Stardance mission Slack bot - answers slash commands over Socket Mode.",
    "background_color": "#4a154b"
  },
  "features": {
    "bot_user": {
      "display_name": "Sripin Bot",
      "always_online": true
    },
    "slash_commands": [
      { "command": "/sripin-ping", "description": "Latency and uptime", "should_escape": false },
      { "command": "/sripin-help", "description": "List available commands", "should_escape": false },
      { "command": "/sripin-catfact", "description": "Get a random cat fact", "should_escape": false },
      { "command": "/sripin-joke", "description": "Get a random joke", "should_escape": false },
      { "command": "/sripin-quote", "description": "Get a random inspirational quote", "should_escape": false },
      { "command": "/sripin-weather", "description": "Current weather for a place", "usage_hint": "<place>", "should_escape": false },
      { "command": "/sripin-define", "description": "Dictionary definition of a word", "usage_hint": "<word>", "should_escape": false },
      { "command": "/sripin-trivia", "description": "Random multiple-choice trivia question", "should_escape": false },
      { "command": "/sripin-number", "description": "Interesting fact about a number", "usage_hint": "[n]", "should_escape": false },
      { "command": "/sripin-rps", "description": "Play rock-paper-scissors with the bot", "usage_hint": "rock|paper|scissors", "should_escape": false },
      { "command": "/sripin-8ball", "description": "Ask the magic 8-ball", "usage_hint": "[question]", "should_escape": false },
      { "command": "/sripin-roll", "description": "Roll dice", "usage_hint": "[NdM, e.g. 2d6]", "should_escape": false },
      { "command": "/sripin-flip", "description": "Flip a coin", "should_escape": false },
      { "command": "/sripin-choose", "description": "Pick one option at random", "usage_hint": "a, b, c", "should_escape": false }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "commands",
        "app_mentions:read",
        "channels:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
